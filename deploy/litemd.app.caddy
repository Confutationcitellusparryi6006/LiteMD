# 官网。放到服务器的 /etc/caddy/sites/litemd.app.caddy，然后 systemctl reload caddy。
# 站点文件由 scripts/deploy-site.sh 同步到 /var/www/litemd.app。
litemd.app {
	# 磁盘映像本身已经压缩过，再压一遍只是白烧 CPU。
	@compressible not path /releases/*
	encode @compressible zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	@static path *.png *.ico *.woff2 *.css *.js *.webmanifest
	header @static Cache-Control "public, max-age=86400"
	header / Cache-Control "no-cache"
	header /index.html Cache-Control "no-cache"
	# 安装包文件名带版本号，内容不会变，可以长缓存。
	# 必须先确认文件存在：否则包还没传上去时的一次 404 会被 CDN 按 30 天缓存住，
	# 之后文件传上来了，用户拿到的仍然是 404（这个坑踩过一次，靠手动清缓存才恢复）。
	# 注意：重新打同一个版本号会被 CDN 挡住，那种情况要手动清缓存。
	@release_files {
		path /releases/*.dmg /releases/*.zip
		file
	}
	header @release_files Cache-Control "public, max-age=2592000"
	# 更新清单必须实时：缓存住它，客户端就收不到新版本。
	header /releases/appcast.json Cache-Control "no-cache"

	root * /var/www/litemd.app
	file_server
}

www.litemd.app {
	redir https://litemd.app{uri} permanent
}
